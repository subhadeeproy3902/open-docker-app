<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.subhadeeproy3902.Berth</id>
  <name>Berth</name>
  <summary>A light, native Docker desktop for Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.subhadeeproy3902"><name>Subhadeep Roy</name></developer>
  <description>
    <p>Berth manages the Docker Engine you already run: containers grouped by Compose project, live logs, a shell,
       a file browser, images with Docker Hub search, volumes, networks, build cache, resource graphs and disk clean-up.</p>
    <p>No virtual machine and no background service. It talks straight to the Docker socket, reads live stats from the
       kernel, pauses them when you are not looking, and exits when you close the window.</p>
  </description>
  <launchable type="desktop-id">io.github.subhadeeproy3902.Berth.desktop</launchable>
